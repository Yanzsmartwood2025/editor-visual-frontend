# Frontend / Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Oracle media worker (yt-dlp / Meta scraping only). Use any URL; it is not tied to an Oracle VM.
MEDIA_WORKER_URL=http://localhost:4000
# Backward-compatible name while downstream routes are migrated.
ORACLE_SERVER_URL=${MEDIA_WORKER_URL}
ORACLE_SECRET=change_me

# AI providers configured in Vercel/Coolify.
# These are now preferred over the temporary database key pool.
GROQ_API_KEY=
MISTRAL_API_KEY=

# Temporary compatibility layer still used by auth/storage and as fallback for the old API-key pool.
# Do not remove until those flows are migrated to your Oracle/Coolify services.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Auth: client email-link login and server ID-token verification.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL del Home/Landing (Repo 1) — a donde se redirige cuando no hay sesión ni token
NEXT_PUBLIC_MAIN_SITE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_ADMIN_EMAILS=

# Cloudflare R2 final media storage.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Vercel Sandbox / Remotion render adapter.
VERCEL_SANDBOX_TOKEN=
VERCEL_PROJECT_ID=

# Future AI providers (intentionally no provider is selected yet).
IMAGE_GENERATION_PROVIDER=
TTS_PROVIDER=

# Optional Remotion AWS Lambda rendering (legacy template support)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
