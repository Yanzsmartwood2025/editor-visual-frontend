# Frontend / Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_SITE_URL=

# Browser observability
NEXT_PUBLIC_SENTRY_DSN=

# AI / orchestration providers
GROQ_API_KEY=
MISTRAL_API_KEY=

# Stock media providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Voice / audio providers
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Generative media providers
FAL_KEY=
REPLICATE_API_TOKEN=

# GPU providers
RUNPOD_API_KEY=
VULTR_API_KEY=
# Ubuntu 22.04 Cloud GPU image; override if your Vultr account uses another GPU-enabled OS image.
VULTR_GPU_OS_ID=1743
RUNPOD_ENDPOINT_ID=
# Optional override; default is https://api.runpod.io/graphql
RUNPOD_GRAPHQL_URL=
VAST_API_KEY=
VAST_WORKERGROUP_ID=

# Vast.ai ephemeral GPU guardrails
VAST_MAX_JOB_USD=0.40
VAST_MIN_BALANCE_USD=1.00
VAST_MAX_CONCURRENT_JOBS=1
VAST_MIN_RELIABILITY=0.95
VAST_COST_SAFETY_MULTIPLIER=1.25
VAST_BOOT_GRACE_MINUTES=8
VAST_MAX_HOURLY_USD=0.60

# Vast.ai worker images. Keep blank until a compatible worker image exists.
# Every image must expose an executable /opt/nayla/run-job.
VAST_GPU_WORKER_IMAGE=
VAST_IMAGE_WORKER_IMAGE=
VAST_VIDEO_WORKER_IMAGE=
VAST_AUDIO_WORKER_IMAGE=
VAST_3D_WORKER_IMAGE=

# 3D providers
TRIPO_API_KEY=
MESHY_API_KEY=

# Supabase database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_ADMIN_EMAILS=

# Cloudflare R2 media vault
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Social publishing providers (server-only)
# Route A
UPLOAD_POST_API_KEY=
UPLOAD_POST_WEBHOOK_SECRET=
# Upload-Post Free currently includes two provider profiles. Nayla uses one
# provider profile per project; each profile can connect one account per platform.
UPLOAD_POST_PROFILE_LIMIT=2
# Free currently does not include TikTok publishing. Set true after upgrading Upload-Post.
UPLOAD_POST_TIKTOK_ENABLED=false

# Route B
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Number of connected accounts to use on this route before Nayla reports both routes full.
# Use 0 for no local limit.
ZERNIO_ACCOUNT_LIMIT=2

# Provider routing preferences (optional)
IMAGE_GENERATION_PROVIDER=
VIDEO_GENERATION_PROVIDER=
AUDIO_GENERATION_PROVIDER=
TTS_PROVIDER=
GPU_PROCESSING_PROVIDER=
THREED_GENERATION_PROVIDER=


# Nayla commercial presentation layer (server-only)
# Leave Cloud prices empty until the business price is decided.
NAYLA_CLOUD_IMAGE_PRICE_USD=
NAYLA_CLOUD_VIDEO_PRICE_USD=
NAYLA_CLOUD_AUDIO_PRICE_USD=
NAYLA_CLOUD_3D_PRICE_USD=

# Nayla Compute public price = upstream hourly cost * multiplier + fixed hourly amount.
# Defaults are neutral until a commercial margin is approved.
NAYLA_COMPUTE_PRICE_MULTIPLIER=1
NAYLA_COMPUTE_FIXED_HOURLY_USD=0

# Nayla PC commercial layer. Defaults expose upstream compute cost only.
# Windows licensing is intentionally not added until an exact live license quote is available.
NAYLA_PC_PRICE_MULTIPLIER=1
NAYLA_PC_FIXED_HOURLY_USD=0
# Hard safety caps for a single confirmed creation. Raise deliberately if needed.
NAYLA_PC_MAX_SESSION_USD=100
NAYLA_PC_MAX_MONTHLY_USD=750
# End hourly leases slightly before the provider billing boundary so cleanup latency cannot spill into another billed hour.
NAYLA_PC_LEASE_SAFETY_SECONDS=90


# Optional Nayla Cloud model overrides (server-only)
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_IMAGE_EDIT_MODEL=fal-ai/flux/dev/image-to-image
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/turbo/standard/text-to-video
FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/kling-video/v3/standard/image-to-video
FAL_AUDIO_MODEL=fal-ai/stable-audio-25/text-to-audio
FAL_3D_MODEL=

REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_IMAGE_EDIT_MODEL=
REPLICATE_VIDEO_MODEL=google/veo-3.1-fast

DEEPGRAM_TTS_MODEL=aura-2-celeste-es
DEEPGRAM_STT_MODEL=nova-3
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_API_VERSION=2026-08-14
CARTESIA_DEFAULT_VOICE_ID=

ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

TRIPO_IMAGE_MODEL=flux.1_kontext_pro
TRIPO_3D_MODEL=v3.1-20260211
TRIPO_MULTIVIEW_MODEL=v3.1-20260211
MESHY_3D_MODEL=latest

# Optional separate secret for opaque GPU selection tokens.
# If empty, Nayla Compute falls back to VAST_API_KEY server-side.
NAYLA_COMPUTE_SELECTION_SECRET=
